// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
    "name": "RAG with Azure SQL Database, LangChain, LangGraph, and Chainlit",
    "image": "mcr.microsoft.com/devcontainers/python:0-3.11-bullseye",
    "features": {
        "ghcr.io/azure/azure-dev/azd:latest": {},
        "ghcr.io/devcontainers/features/azure-cli:1": {
            "installBicep": true
        },
        "ghcr.io/devcontainers/features/common-utils": {},
        "ghcr.io/devcontainers/features/docker-in-docker:2": {},
        "ghcr.io/devcontainers/features/dotnet:2": "8.0",
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers-contrib/features/coverage-py:2": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-azuretools.vscode-azurefunctions",
                "ms-azuretools.vscode-bicep",
                "ms-azuretools.vscode-docker",
                "ms-dotnettools.csdevkit",
                "ms-dotnettools.csharp",
                "ms-dotnettools.dotnet-interactive-vscode",
                "ms-dotnettools.vscode-dotnet-runtime",
                "ms-python.python",
                "ms-vscode.azure-account"
            ]
        }
    },
    "postStartCommand": "cd ./chainlit && python3 -m venv .venv && . .venv/bin/activate && pip install -r requirements.txt",
    "remoteUser": "vscode",
    "forwardPorts": [
        8000
    ]
}
